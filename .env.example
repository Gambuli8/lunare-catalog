# Copiá este archivo a .env y completá el valor.
# En Vercel se carga desde Settings → Environment Variables (los tres
# entornos: Production, Preview y Development).
#
# URL del CSV del Google Sheet publicado.
# Solo la lee el servidor, en /api/products. Nunca llega al navegador.
#
# ⚠️ Antes de generar esta URL, revisá que la hoja publicada NO incluya la
#    columna "Precio costo". Ver README → "Catálogo y precios".
SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/XXXXX/pub?gid=0&single=true&output=csv

# Dominio público del sitio. Se usa en las URLs canónicas, en las meta de
# compartir y en el sitemap. Por defecto: https://www.lunareacc.com
# SITE_URL=https://www.lunareacc.com

# ── Modo mantenimiento (opcional) ─────────────────────────────
# Pone una cortina sobre todo el sitio. Se prende y apaga desde Vercel.
# Sin definir = tienda abierta.
# MANTENIMIENTO=1
# MANTENIMIENTO_PASSWORD=elegí-una-clave

# ── Pedidos (Supabase) ────────────────────────────────────────
# Necesarias para que funcione /api/pedido. Sin ellas el checkout
# devuelve 503 y la tienda sigue andando por WhatsApp.
#
# La service role key saltea RLS: va SOLO en el servidor, nunca en el
# navegador y nunca en el repo.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Avisos de pedidos (Resend) ────────────────────────────────
# Sin estas variables el pedido igual se guarda, pero no le llega el
# mail a nadie: hay que mirar la base para enterarse. Ver README →
# "Avisos de pedidos".
#
# La API key de https://resend.com/api-keys
RESEND_API_KEY=
# A qué casilla (o casillas, separadas por coma) avisamos que entró un pedido.
AVISO_EMAIL_DESTINO=
# Remitente. El dominio tiene que estar verificado en Resend.
# Por defecto: Lunare Accesorios <pedidos@lunareacc.com>
# AVISO_EMAIL_FROM=Lunare Accesorios <pedidos@lunareacc.com>

# ── Panel de pedidos ──────────────────────────────────────────
# La clave para entrar a /panel. Sin ella el panel devuelve 503 y no
# toca la base.
#
# ⚠️ Mínimo 10 caracteres, con mayúsculas, minúsculas y números, y el
#    panel se niega a andar con menos. Junto con el límite de intentos (5
#    por conexión cada 15 minutos) es lo que impide adivinarla probando, y
#    del otro lado hay nombres, teléfonos y direcciones de las clientas.
#    Que no sea la misma que MANTENIMIENTO_PASSWORD.
PANEL_PASSWORD=

# ── Mercado Pago ──────────────────────────────────────────────
# Sin estas variables el checkout sigue funcionando: el pedido se guarda
# y el cobro se coordina a mano, como antes.
#
# El Access Token de Tus integraciones. El de prueba empieza con TEST-.
# El Public Key NO hace falta: en Checkout Pro la preferencia se arma en
# el servidor y no hay nada que tokenizar en el navegador.
MP_ACCESS_TOKEN=
# La clave secreta del webhook, en Tus integraciones > Webhooks.
# Sin ella /api/mp-webhook devuelve 503 y no procesa nada: es la unica
# forma de saber si una notificacion es de verdad.
MP_WEBHOOK_SECRET=

# ── Fotos de productos (Cloudinary) ───────────────────────────
# Para subir fotos desde el panel. Sin estas variables el panel igual
# deja pegar el link de una foto. Salen de cloudinary.com → Settings →
# API Keys. El secreto va SOLO acá y en Vercel, nunca en el repo.
CLOUDINARY_CLOUD_NAME=dtbasr3hw
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Meta (Facebook e Instagram) ───────────────────────────────
# Sin estas variables no se carga nada de Meta. Ver README → "Meta y Google".
#
# El id del píxel (Administrador de eventos). Es público: lo lee el
# navegador, por eso empieza con VITE_. Cambiarlo pide un deploy nuevo.
VITE_META_PIXEL_ID=
# Para avisar las compras desde el servidor (API de conversiones). Va
# SOLO en el servidor. Administrador de eventos → el píxel → Configuración.
META_CAPI_TOKEN=
# Opcional: el código de "Probar eventos", mientras se prueba.
# META_TEST_EVENT_CODE=

# ── Cron de pedidos vencidos ──────────────────────────────────
# Vercel lo manda como "Authorization: Bearer <CRON_SECRET>" a
# /api/cron-vencidos. Sin él el cron no cancela nada. Cualquier cadena
# larga y aleatoria, por ejemplo: openssl rand -hex 32
CRON_SECRET=

# Copiá este archivo a .env y completá el valor.
# En Vercel se carga desde Settings → Environment Variables (los tres
# entornos: Production, Preview y Development).
#
# URL del CSV del Google Sheet publicado.
# Solo la lee el servidor, en /api/products. Nunca llega al navegador.
#
# ⚠️ Antes de generar esta URL, revisá que la hoja publicada NO incluya la
#    columna "Precio costo". Ver README → "Catálogo y precios".
SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/XXXXX/pub?gid=0&single=true&output=csv

# Dominio público del sitio. Se usa en las URLs canónicas, en las meta de
# compartir y en el sitemap. Por defecto: https://www.lunareacc.com
# SITE_URL=https://www.lunareacc.com

# ── Modo mantenimiento (opcional) ─────────────────────────────
# Pone una cortina sobre todo el sitio. Se prende y apaga desde Vercel.
# Sin definir = tienda abierta.
# MANTENIMIENTO=1
# MANTENIMIENTO_PASSWORD=elegí-una-clave

# ── Pedidos (Supabase) ────────────────────────────────────────
# Necesarias para que funcione /api/pedido. Sin ellas el checkout
# devuelve 503 y la tienda sigue andando por WhatsApp.
#
# La service role key saltea RLS: va SOLO en el servidor, nunca en el
# navegador y nunca en el repo.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Avisos de pedidos (Resend) ────────────────────────────────
# Sin estas variables el pedido igual se guarda, pero no le llega el
# mail a nadie: hay que mirar la base para enterarse. Ver README →
# "Avisos de pedidos".
#
# La API key de https://resend.com/api-keys
RESEND_API_KEY=
# A qué casilla (o casillas, separadas por coma) avisamos que entró un pedido.
AVISO_EMAIL_DESTINO=
# Remitente. El dominio tiene que estar verificado en Resend.
# Por defecto: Lunare Accesorios <pedidos@lunareacc.com>
# AVISO_EMAIL_FROM=Lunare Accesorios <pedidos@lunareacc.com>

# ── Panel de pedidos ──────────────────────────────────────────
# La clave para entrar a /panel. Sin ella el panel devuelve 503 y no
# toca la base.
#
# ⚠️ Mínimo 16 caracteres, y el panel se niega a andar con menos. Es la
#    única defensa contra que alguien pruebe claves contra el endpoint, y
#    del otro lado hay nombres, teléfonos y direcciones de las clientas.
#    Que no sea la misma que MANTENIMIENTO_PASSWORD.
PANEL_PASSWORD=

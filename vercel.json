{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/producto/:slug", "destination": "/api/page?slug=:slug" },
    { "source": "/tienda", "destination": "/api/shop" },
    { "source": "/tienda/:cat", "destination": "/api/shop?cat=:cat" },
    { "source": "/cuidados", "destination": "/api/pagina?pagina=cuidados" },
    { "source": "/cambios", "destination": "/api/pagina?pagina=cambios" },
    { "source": "/contacto", "destination": "/api/pagina?pagina=contacto" },
    { "source": "/arrepentimiento", "destination": "/api/pagina?pagina=arrepentimiento" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
